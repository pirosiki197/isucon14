# サーバーのアドレス。servers.env にコピーして実際の値を書く。
# servers.env は .gitignore 済みで、リポジトリには含めない。
#
#   cp servers.env.example servers.env && $EDITOR servers.env

# 触るサーバの一覧。bin/config はこれを見て回る。
HOSTS="app db bench"

# ホストごとに 3 つ。<名前>_ROLES は省略可 (省略時はホスト名がそのまま role)。
#   <名前>_HOST         ssh で入るアドレス (グローバル IP か DNS 名)
#   <名前>_PRIVATE_IP   VPC 内部の IP。ベンチの --addr とアプリの ISUCON_DB_HOST に使う
#   <名前>_ROLES        そのホストが担っている役割。複数なら空白区切り
APP_HOST=""         # アプリ + nginx
APP_PRIVATE_IP=""
APP_ROLES="app"

DB_HOST=""          # MySQL
DB_PRIVATE_IP=""
DB_ROLES="db"

BENCH_HOST=""       # ベンチマーカー (本番には無い。ポータルから実行する)
BENCH_PRIVATE_IP=""
BENCH_ROLES="bench"

# ssh のユーザ (既定 isucon)
# SSH_USER="isucon"

# --- 本番 (3 台とも同じスペックで、役割を自分で決める) ならこう書く ------
# ホスト名は大会中に変わらないものにする。役割は途中で変わるので、
# 役割で名付けると infra/ の中でファイルが引っ越して履歴が追えなくなる。
#
# HOSTS="s1 s2 s3"
# S1_HOST=""   S1_PRIVATE_IP=""   S1_ROLES="app db"   # 最初は 1 台に全部載っている
# S2_HOST=""   S2_PRIVATE_IP=""   S2_ROLES=""
# S3_HOST=""   S3_PRIVATE_IP=""   S3_ROLES=""
