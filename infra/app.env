# この大会のアプリの定義。bin/deploy と bin/bench が読む。
#
# 初動で `systemctl cat <unit>` を見ながら埋める。ここに書いてあるおかげで
# ツール側には大会固有の名前が出てこない。次の大会ではこの 5 行を直すだけ。
#
# アドレスと違って秘密ではないので、このファイルは git 管理下に置く。

APP_DIR="/home/isucon/webapp"         # サーバー上のアプリのルート (git repo にする場所)
BUILD_DIR="go"                        # APP_DIR からの相対。go build するところ
APP_BINARY="isuride"                  # unit の ExecStart のファイル名と一致させる
APP_SERVICE="isuride-go"              # コードを変えたら再起動する unit
EXTRA_SERVICES=""                     # 一緒に再起動するもの。通常は空
HEALTH_URL="http://127.0.0.1:8080/"   # 起動確認。000 以外が返れば待ち受けている

# isuride-matcher はここに入れない。中身は curl のループでアプリコードを
# 含まないので、コードを変えても再起動する必要がない。
