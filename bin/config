#!/bin/bash
# サーバ上の設定ファイルをリポジトリ (infra/) と同期する。
#
#   pull … サーバ → infra/。広く取る。何が変わったかはローカルの git status で見る
#   push … infra/ → サーバ。MANIFEST に書いたものだけを配り、反映コマンドを叩く
#   copy … infra/ の中で、あるホストの設定を別のホストにコピーする (台数を増やすとき)
#
# 使い方:
#   bin/config pull [host|role...]        既定は servers.env の HOSTS 全部
#   bin/config push <host|role> [path...] path 省略で MANIFEST のそのホスト分全部
#   bin/config copy <src-host> <dst-host> [path...]
#   bin/config status
#
#   -n  転送も reload もせず、サーバ側との差分だけを出す

set -euo pipefail
cd "$(dirname "$0")/.."

infra=infra
exclude_file="$infra/rsync-exclude"
pull_list="$infra/PULL"
manifest="$infra/MANIFEST"

dry=""

die() {
	echo "error: $*" >&2
	exit 1
}
warn() { echo "warn:  $*" >&2; }

usage() {
	sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
	exit "${1:-1}"
}

load_env() {
	[ -f servers.env ] || die "servers.env が無い (servers.env.example をコピーして作る)"
	# shellcheck disable=SC1091
	. ./servers.env
	: "${HOSTS:?servers.env に HOSTS を設定してください (例: HOSTS=\"s1 s2 s3\")}"
	ssh_user="${SSH_USER:-isucon}"
	# 落ちているホストで待たされないようにする
	ssh_cmd="ssh -o ConnectTimeout=${SSH_CONNECT_TIMEOUT:-10}"
}

# ホスト名 foo に対して FOO_HOST / FOO_PRIVATE_IP / FOO_ROLES を引く
hostvar() {
	local name="$1" suffix="$2" var
	[[ "$name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "ホスト名に使えない文字: $name"
	var="${name^^}_$suffix"
	echo "${!var:-}"
}

host_addr() { hostvar "$1" HOST; }
host_roles() {
	local r
	r=$(hostvar "$1" ROLES)
	echo "${r:-$1}" # 未指定ならホスト名そのものを role とみなす
}

is_host() {
	local h
	for h in $HOSTS; do [ "$h" = "$1" ] && return 0; done
	return 1
}

# 引数をホスト名または role として解決し、対象ホストを列挙する
resolve_hosts() {
	local want="$1" h r found=""
	if is_host "$want"; then
		echo "$want"
		return 0
	fi
	for h in $HOSTS; do
		for r in $(host_roles "$h"); do
			if [ "$r" = "$want" ]; then
				echo "$h"
				found=1
				break
			fi
		done
	done
	[ -n "$found" ] || die "$want というホストも role も無い (HOSTS=\"$HOSTS\")"
}

host_has_role() {
	local h="$1" want="$2" r
	[ "$want" = '*' ] && return 0
	for r in $(host_roles "$h"); do [ "$r" = "$want" ] && return 0; done
	return 1
}

# role を指定して呼ばれたときは、その role の行だけを対象にする。
# ホスト名で呼ばれたとき (role_filter が空) は、そのホストの全 role が対象。
# '*' の行は role_filter によらず常に対象。
entry_applies() {
	local host="$1" entry_role="$2" role_filter="$3"
	[ "$entry_role" = '*' ] && return 0
	if [ -n "$role_filter" ]; then
		[ "$entry_role" = "$role_filter" ] || return 1
	fi
	host_has_role "$host" "$entry_role"
}

# コメント行と空行を落とす
table() { grep -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' "$1"; }

# rsync の出力は rsync_out に取る。失敗したときだけそのまま見せる。
# 23/24 は「一部のパスが無かった」なので警告に留める。
rsync_out=""
run_rsync() {
	local rc=0
	rsync_out=$(rsync "$@" 2>&1) || rc=$?
	case "$rc" in
	0) ;;
	23 | 24)
		warn "rsync exit $rc: 一部のパスをスキップした"
		printf '%s\n' "$rsync_out" >&2
		;;
	*)
		printf '%s\n' "$rsync_out" >&2
		return "$rc"
		;;
	esac
}

# rsync -i の出力のうち、実際に動いた行だけを返す。
# 先頭 1 文字が . のものは中身が変わっていない (属性のみ) なので落とす。
changed_lines() { printf '%s\n' "$rsync_out" | grep -E '^([<>ch]|\*deleting)' || true; }

# 件数だけ出す。初回の /etc のように数千件になるものは先頭だけ見せる
report_changes() {
	local label="$1" lines n
	lines=$(changed_lines)
	n=$(printf '%s' "$lines" | grep -c . || true)
	if [ "$n" -eq 0 ]; then
		printf '   %-24s 変更なし\n' "$label"
		return 0
	fi
	printf '   %-24s %s 件\n' "$label" "$n"
	printf '%s\n' "$lines" | sed -n '1,8s/^/      /p'
	[ "$n" -gt 8 ] && echo "      ... 他 $((n - 8)) 件"
	return 0
}

show_changes() {
	echo
	echo "== 変更 (git status)"
	local n
	n=$(git status --porcelain -- "$infra" | wc -l)
	if [ "$n" -eq 0 ]; then
		echo "   (変更なし)"
		return 0
	fi
	git status --porcelain -- "$infra" | sed -n '1,40p'
	[ "$n" -gt 40 ] && echo "   ... 他 $((n - 40)) 件"
	return 0
}

cmd_pull() {
	local -a hosts=()
	local role_filter=""
	if [ "$#" -eq 0 ]; then
		hosts=($HOSTS)
	else
		local a
		for a in "$@"; do
			hosts+=($(resolve_hosts "$a"))
			is_host "$a" || role_filter="$a"
		done
	fi

	local host addr r path dest
	local -a opts
	for host in "${hosts[@]}"; do
		addr=$(host_addr "$host")
		[ -n "$addr" ] || {
			warn "$host: ${host^^}_HOST が servers.env に無い。skip"
			continue
		}
		echo "== pull $host ($addr) roles=[$(host_roles "$host")]"

		while read -r r path; do
			entry_applies "$host" "$r" "$role_filter" || continue
			dest="$infra/$host/${path#/}"
			opts=(-rlpt -i --human-readable -e "$ssh_cmd" --exclude-from="$exclude_file" --rsync-path='sudo rsync')
			[ -n "$dry" ] && opts+=(--dry-run)

			if [ "${path: -1}" = "/" ]; then
				mkdir -p "$dest"
				# --delete-excluded まで付けないと、後から除外を足しても
				# 既に取得済みのファイルが残り続ける
				opts+=(--delete --delete-excluded)
			else
				mkdir -p "$(dirname "$dest")"
			fi

			if ! run_rsync "${opts[@]}" "$ssh_user@$addr:$path" "$dest"; then
				warn "$host: 転送できないのでこのホストは skip する"
				break
			fi
			report_changes "$path"
		done < <(table "$pull_list")
	done

	show_changes
}

# MANIFEST を展開して、1 行 1 件の TSV を stdout に出す。
#   <ローカルのパス> \t <サーバ上のパス> \t <反映コマンド>
# $1=ホスト名, $2=ソースのホスト名(通常は同じ。copy のときだけ違う),
# $3=role の絞り込み(空なら全部), 残り=パスの絞り込み
collect_manifest() {
	local host="$1" src="$2" role_filter="$3"
	shift 3
	local -a filter=("$@")
	local r path reload local_glob m remote want f

	while read -r r path reload; do
		entry_applies "$host" "$r" "$role_filter" || continue

		local_glob="$infra/$src/${path#/}"
		shopt -s nullglob
		local -a matches=($local_glob)
		shopt -u nullglob

		if [ "${#matches[@]}" -eq 0 ]; then
			[ "${#filter[@]}" -eq 0 ] && warn "ローカルに無い: $local_glob (pull していないか、まだ作っていない)"
			continue
		fi

		for m in "${matches[@]}"; do
			# 末尾が / の行はディレクトリごと配る
			if [ "${path: -1}" = "/" ]; then
				[ -d "$m" ] || continue
			else
				[ -f "$m" ] || continue
			fi
			remote="/${m#"$infra/$src/"}"
			if [ "${#filter[@]}" -gt 0 ]; then
				want=""
				for f in "${filter[@]}"; do
					if [ "$f" = "$path" ] || [ "$f" = "$remote" ]; then want=1; fi
				done
				[ -n "$want" ] || continue
			fi
			printf '%s\t%s\t%s\n' "$m" "$remote" "$reload"
		done
	done < <(table "$manifest")
}

push_one_host() {
	local host="$1" role_filter="$2"
	shift 2
	local addr
	addr=$(host_addr "$host")
	[ -n "$addr" ] || die "$host: ${host^^}_HOST が servers.env に無い"

	# ssh がループの stdin を食うので、先に全件読み切ってから回す
	local -a entries=()
	mapfile -t entries < <(collect_manifest "$host" "$host" "$role_filter" "$@")
	[ "${#entries[@]}" -gt 0 ] || {
		warn "$host: 配るものが無い"
		return 0
	}

	echo "== push $host ($addr)"
	local e lpath remote reload
	local -a opts pending=()
	for e in "${entries[@]}"; do
		IFS=$'\t' read -r lpath remote reload <<<"$e"

		# 所有者とパーミッションは既存のものを保つので -a は使わない
		opts=(-t -i --human-readable -e "$ssh_cmd" --rsync-path='sudo rsync')
		# -n でも rsync は動かす。サーバ側と何が違うかはこれでしか分からない
		[ -n "$dry" ] && opts+=(--dry-run)

		if [ -d "$lpath" ]; then
			# ディレクトリは中身を配る。--delete はしない (サーバ側にしか無いファイルを消さない)
			[ -n "$dry" ] || $ssh_cmd "$ssh_user@$addr" "sudo mkdir -p $remote"
			run_rsync -r "${opts[@]}" "${lpath%/}/" "$ssh_user@$addr:${remote%/}/"
		else
			[ -n "$dry" ] || $ssh_cmd "$ssh_user@$addr" "sudo mkdir -p $(dirname "$remote")"
			run_rsync "${opts[@]}" "$lpath" "$ssh_user@$addr:$remote"
		fi

		report_changes "$remote"
		# 変わったファイルの反映コマンドだけを積む。触っていないファイルのために
		# サービスを再起動しないため
		if [ -n "$(changed_lines)" ] && [ -n "$reload" ]; then pending+=("$reload"); fi
	done

	if [ "${#pending[@]}" -eq 0 ]; then
		echo "== $host: 変更が無いので reload しない"
		return 0
	fi

	# 同じ反映コマンドは 1 回にまとめる
	local -a done_cmds=()
	local c d seen
	for c in "${pending[@]}"; do
		seen=""
		for d in "${done_cmds[@]:-}"; do
			if [ "$d" = "$c" ]; then seen=1; fi
		done
		[ -n "$seen" ] && continue
		done_cmds+=("$c")
		echo "== reload $host: $c"
		[ -n "$dry" ] && continue
		$ssh_cmd "$ssh_user@$addr" "$c"
	done
}

cmd_push() {
	[ "$#" -ge 1 ] || usage
	local target="$1"
	shift
	local h role_filter=""
	is_host "$target" || role_filter="$target"
	for h in $(resolve_hosts "$target"); do
		push_one_host "$h" "$role_filter" "$@"
	done
}

cmd_copy() {
	[ "$#" -ge 2 ] || usage
	local src="$1" dst="$2"
	shift 2
	is_host "$src" || die "$src はホスト名ではない"
	is_host "$dst" || die "$dst はホスト名ではない"
	[ -d "$infra/$src" ] || die "$infra/$src が無い (先に pull する)"

	local -a entries=()
	mapfile -t entries < <(collect_manifest "$dst" "$src" "" "$@")
	[ "${#entries[@]}" -gt 0 ] ||
		die "コピーするものが無い ($dst の role は [$(host_roles "$dst")]。servers.env の ${dst^^}_ROLES を確認する)"

	echo "== copy $src -> $dst (ローカルのみ。反映は push $dst)"
	local e lpath remote reload dest
	for e in "${entries[@]}"; do
		IFS=$'\t' read -r lpath remote reload <<<"$e"
		dest="$infra/$dst/${remote#/}"
		echo "   $lpath -> $dest"
		[ -n "$dry" ] && continue
		if [ -d "$lpath" ]; then
			mkdir -p "$dest"
			cp -a "${lpath%/}/." "${dest%/}/"
		else
			mkdir -p "$(dirname "$dest")"
			cp -p "$lpath" "$dest"
		fi
	done

	show_changes
	echo
	echo "   差分を確認してから: bin/config push $dst"
}

cmd_status() {
	local h addr n
	printf '%-8s %-16s %-16s %s\n' HOST ADDR ROLES FILES
	for h in $HOSTS; do
		addr=$(host_addr "$h")
		n=0
		[ -d "$infra/$h" ] && n=$(find "$infra/$h" \( -type f -o -type l \) | wc -l)
		printf '%-8s %-16s %-16s %s\n' "$h" "${addr:-(未設定)}" "$(host_roles "$h")" "$n"
	done
	show_changes
}

main() {
	local -a args=()
	while [ "$#" -gt 0 ]; do
		case "$1" in
		-n | --dry-run) dry=1 ;;
		-h | --help) usage 0 ;;
		*) args+=("$1") ;;
		esac
		shift
	done
	[ "${#args[@]}" -ge 1 ] || usage

	command -v rsync >/dev/null || die "rsync が無い。sudo apt install rsync"
	load_env

	local sub="${args[0]}"
	set -- "${args[@]:1}"
	case "$sub" in
	pull) cmd_pull "$@" ;;
	push) cmd_push "$@" ;;
	copy) cmd_copy "$@" ;;
	status) cmd_status "$@" ;;
	*) usage ;;
	esac
}

main "$@"
